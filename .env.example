# Settings for running the remote contract suite against a real S3-compatible bucket
# (see docs/s3-testing.md). Copy this file to `.env` and fill in the two secrets.
# `.env` is git-ignored: never commit it, never paste its contents into a chat.
FLINT_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
FLINT_S3_BUCKET=<bucket name>
FLINT_S3_REGION=auto
FLINT_S3_ACCESS_KEY=
FLINT_S3_SECRET_KEY=
